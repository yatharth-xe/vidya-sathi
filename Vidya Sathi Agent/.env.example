# Copy this file to .env and fill in local values.
# Never commit a real API key.

# Ollama Cloud (or a local Ollama daemon)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# Optional: scholarship web search provider (server-side use only)
TAVILY_API_KEY=
# SCHOLARSHIP_SEARCH_TIMEOUT=10
# SCHOLARSHIP_MAX_RESULTS=5

# Chat model used by the Student Agent
VIDYA_SATHI_MODEL=gpt-oss:120b-cloud

# Optional path overrides (defaults are relative to the project root)
# VIDYA_SATHI_CORPUS_PATH=data/knowledge_chunks_final.jsonl
# VIDYA_SATHI_CHROMA_DIR=data/chroma_db
# VIDYA_SATHI_COLLECTION_NAME=ncert_knowledge
# VIDYA_SATHI_BGE_MODEL=BAAI/bge-small-en-v1.5
# VIDYA_SATHI_MODEL_CACHE=data/model_cache
# VIDYA_SATHI_TOP_K=10
# VIDYA_SATHI_CANDIDATE_K=50
# VIDYA_SATHI_RRF_K=60
