# FastAPI configuration
PROJECT_NAME="Vidya Sathi API"
API_V1_STR="/api/v1"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database
DATABASE_URL="sqlite:///./vidya_sathi.db"


# File upload directory
UPLOAD_DIR="./uploads"

# ── NCERT Student Agent (ML Member 2) ──────────────────────────────────────
# Names only — do NOT put real secret values here.
# The NCERT Agent project ("Vidya Sathi Agent/") loads its own .env from its
# project root, including these:
#   OLLAMA_BASE_URL      - Ollama Cloud endpoint (server-side only)
#   OLLAMA_API_KEY       - Ollama Cloud auth key (NEVER commit / NEVER send to React)
#   VIDYA_SATHI_MODEL    - chat model name used by the Student Agent
